{
  "name": "zpl-label-studio-server",
  "version": "2.0.0",
  "private": true,
  "description": "API that forwards ZPL labels to network printers",
  "main": "src/index.js",
  "bin": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build:exe": "pkg . --targets node22-win-x64 --output ../dist/zpl-label-studio.exe"
  },
  "dependencies": {
    "express": "^4.19.2",
    "jsbarcode": "^3.12.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.0.0"
  },
  "pkg": {
    "assets": [
      "../client/dist/**/*"
    ],
    "scripts": [
      "src/**/*.js"
    ]
  }
}
